{
  "expo": {
    "name": "NOIR Mobile Studio",
    "slug": "noir-mobile-studio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "noirmobilestudio",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.noir.mobilestudio"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1e9a802b-e6fe-484e-8bce-bcaf98c139d8"
      }
    }
  }
}
